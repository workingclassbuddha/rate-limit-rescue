{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-context-protocol:open-context-pack:0.2",
  "title": "Open Context Pack",
  "description": "Portable task-state capsule for continuing AI work across assistants.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "version",
    "id",
    "createdAt",
    "source",
    "task",
    "artifacts",
    "target",
    "review",
    "continuationPrompt"
  ],
  "properties": {
    "protocol": {
      "type": "string",
      "const": "open-context-protocol"
    },
    "version": {
      "type": "string",
      "const": "0.2"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "savedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "app",
        "label",
        "title",
        "url",
        "hostname",
        "pageType",
        "description",
        "headings",
        "provenance"
      ],
      "properties": {
        "app": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "hostname": { "type": "string" },
        "pageType": { "type": "string" },
        "description": { "type": "string" },
        "headings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "captureMethod",
            "capturedBy",
            "capturedAt",
            "userInitiated"
          ],
          "properties": {
            "captureMethod": { "type": "string", "minLength": 1 },
            "capturedBy": { "type": "string", "minLength": 1 },
            "capturedAt": { "type": "string" },
            "userInitiated": { "type": "boolean" }
          }
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal",
        "currentState",
        "decisions",
        "constraints",
        "openQuestions",
        "nextSteps"
      ],
      "properties": {
        "goal": { "type": "string", "minLength": 1 },
        "currentState": { "type": "string", "minLength": 1 },
        "decisions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "constraints": {
          "type": "array",
          "items": { "type": "string" }
        },
        "openQuestions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "nextSteps": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selectedText",
        "pageText",
        "messages",
        "attachments"
      ],
      "properties": {
        "selectedText": { "type": "string" },
        "pageText": { "type": "string" },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "text"],
            "properties": {
              "role": {
                "type": "string",
                "enum": ["user", "assistant", "system", "unknown"]
              },
              "text": { "type": "string", "minLength": 1 },
              "timestamp": { "type": "string" }
            }
          }
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "label", "url"],
            "properties": {
              "type": { "type": "string" },
              "label": { "type": "string" },
              "url": { "type": "string" }
            }
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app", "label", "url", "intent"],
      "properties": {
        "app": { "type": "string" },
        "label": { "type": "string" },
        "url": { "type": "string" },
        "intent": { "type": "string" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "localOnly",
        "userReviewed",
        "userMediated",
        "autoSendAllowed",
        "notes"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["captured", "prepared", "reviewed", "inserted", "exported", "imported"]
        },
        "localOnly": { "type": "boolean" },
        "userReviewed": { "type": "boolean" },
        "userMediated": { "type": "boolean" },
        "autoSendAllowed": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "continuationPrompt": {
      "type": "string",
      "minLength": 1
    }
  }
}
